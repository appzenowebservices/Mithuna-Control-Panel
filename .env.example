# Super-admin / tenant essentials for the agent-panel deployment.
# Copy to `.env` (same directory as docker-compose.yml) and fill in values:
#   cp .env.example .env
# `.env` is gitignored AND dockerignored — it never leaves this machine.
# Everything here is loaded straight into the container via `env_file`,
# so this file is the single source of truth for instance configuration.

# --- REQUIRED: Supabase Postgres (pooler, IPv4) ---
# Copy the *Transaction pooler* string from Supabase dashboard → Connect.
# The container refuses to start without it.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# --- REQUIRED: auth signing secret (32+ random chars) ---
# Generate: openssl rand -base64 32
# Rotating it signs everyone out — set it once, before inviting users.
BETTER_AUTH_SECRET=change-me-to-32-plus-random-chars

# --- Super-admin login (SaaS operator, RECOMMENDED) ---
# Synced into the container at every boot: the account is created when missing,
# its password is re-synced from here (applies on restart, existing sessions
# stay valid), and it holds instance_admin + owner in every company.
# This replaces the one-time board-claim flow. Unset both to disable.
# PAPERCLIP_SUPERADMIN_EMAIL=admin@example.com
# PAPERCLIP_SUPERADMIN_PASSWORD=change-me-min-8-chars

# --- Public surface (Caddy already routes these here) ---
PAPERCLIP_PUBLIC_URL=https://agent-panel.appzenowebservices.com

# --- Google SSO (optional) ---
# Both values must be set to enable the "Continue with Google" button.
# Authorized redirect URI in Google Cloud: <PAPERCLIP_PUBLIC_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Welcome email via Patra (optional) ---
# Sent when a super-admin grants company access. Create the API user in Patra
# (Admin -> Users) with the `tx:send` permission, then create the template with
#   node scripts/patra-welcome-template.mjs
# and paste the printed id here.
# PATRA_API_URL=https://omnipost.appzenowebservices.com
# PATRA_API_USER=
# PATRA_API_PASSWORD=
# PATRA_WELCOME_TEMPLATE_ID=

# --- Rarely changed (defaults match docker-compose.yml) ---
# HOST=0.0.0.0
# PORT=3000
# SERVE_UI=true
# NODE_ENV=production
# PAPERCLIP_HOME=/paperclip
# PAPERCLIP_INSTANCE_ID=default
# PAPERCLIP_CONFIG=/paperclip/instances/default/config.json
# PAPERCLIP_DEPLOYMENT_MODE=authenticated
# PAPERCLIP_DEPLOYMENT_EXPOSURE=public

# --- Optional ---
# Direct (non-pooler) URL used only for migrations when the pooler can't run DDL.
# Leave unset to run everything through DATABASE_URL.
# DATABASE_MIGRATION_URL=postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres
# Set to "true" once bootstrapped to close open registration (invited users
# must already have accounts before you flip this — invites can't create them).
# PAPERCLIP_AUTH_DISABLE_SIGN_UP=false

# --- Skill catalog roots (optional) ---
# The image already bundles hermes-skills/ (93) + hermes-optional-skills/ (101)
# and repo skills/ (15). Add extra directories here to union more libraries at
# boot; later roots win slug collisions. Separate with ";" (Windows) or ":"
# (Linux). Prefer absolute paths inside the container.
# PAPERCLIP_SKILLS_ROOTS=/skills-extra:/another/library
